# 服务端本地已构建的索引路径，相对项目根目录解析
INDEX=example-data/index.bin
# 本实例 ERI 对应网卡的本地 IPv4 地址，请替换为实际值
BIND=10.0.0.8
# RDMA_CM 监听端口；cm 后端不再建立额外 TCP 控制 socket
PORT=18515
# eRDMA 使用 CM 建连，两端必须一致
RDMA_CONNECTION=cm
# 可留空，由 CM 按 IP 路由选卡；非空时校验选中设备名
IB_DEVICE=erdma_0
# RDMA 设备端口号；由 ibv_devinfo 确认
IB_PORT=1
# 建连和每个操作的超时时间（毫秒），不限制空闲 session 时长
RDMA_TIMEOUT_MS=10000
