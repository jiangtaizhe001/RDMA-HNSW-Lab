# RDMA 模式不需要本地索引文件；元数据由存储节点自动获取
# 存储节点的管理网或控制面 IP 地址
STORAGE_HOST=127.0.0.1
# 必须与存储节点 PORT 一致
PORT=18515
# 计算节点使用的 InfiniBand/RDMA HCA 设备名称
IB_DEVICE=mlx5_0
# 计算节点使用的 HCA 端口号
IB_PORT=1
# 查询数量、线程数和工作负载由 example/rdma_client.cc 中的示例代码定义
# 建连方式，必须与存储端一致：ib 或 cm
RDMA_CONNECTION=ib
# CM 建连和单次操作超时（毫秒）
RDMA_TIMEOUT_MS=10000
