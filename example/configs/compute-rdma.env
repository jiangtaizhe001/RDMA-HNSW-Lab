# RDMA 模式不需要本地索引文件；元数据由存储节点自动获取
INDEX=
# 存储节点的管理网或控制面 IP 地址
STORAGE_HOST=127.0.0.1
# 必须与存储节点 PORT 一致
PORT=18515
# 计算节点使用的 InfiniBand/RDMA HCA 设备名称
IB_DEVICE=mlx5_0
# 计算节点使用的 HCA 端口号
IB_PORT=1
# 本次运行发送的查询向量数量；未指定 --queries 时自动生成
QUERY_COUNT=1000
# HNSW 查询阶段的搜索宽度
EF_SEARCH=64
# 每条查询返回的近邻数量
K=10
# 读取策略名称；当前内置 fixed，其余策略由学生通过 API 扩展
READ_STRATEGY=fixed
# 距离函数：l2 为平方欧氏距离，ip 为内积距离
DISTANCE=l2
# 工作负载类型：query 只查询，mixed 交错执行查询和更新
WORKLOAD=query
