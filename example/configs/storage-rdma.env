# 存储节点加载的索引文件；该文件应在存储节点本地存在
INDEX=example-data/index.bin
# RDMA 控制面 TCP 监听地址；0.0.0.0 表示监听所有网卡
BIND=0.0.0.0
# RDMA 控制面 TCP 监听端口，计算节点必须使用相同端口
PORT=18515
# 使用的 InfiniBand/RDMA HCA 设备名称，可由 ibv_devinfo -l 查看
IB_DEVICE=mlx5_0
# 使用的 HCA 端口号，通常为 1；应处于 Active 状态
IB_PORT=1
# 建连方式：ib 使用传统 LID；cm 使用 RDMA_CM（适用于 eRDMA）
RDMA_CONNECTION=ib
# CM 建连和单次操作超时；空闲连接不因这个时间主动关闭
RDMA_TIMEOUT_MS=10000
